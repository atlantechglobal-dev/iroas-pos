PORT=4000
NODE_ENV=development

# Long random string in production — e.g. `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-long-random-string

# Seeded platform admin login (used by `npm run seed`)
# ADMIN_EMAIL is also used as a fallback admin notify address
ADMIN_EMAIL=admin@iroas.com
ADMIN_PASSWORD=IroasAdmin@123
ADMIN_NAME=IROAS Admin

# Preferred inbox for onboarding review + approval notification emails
ADMIN_NOTIFY_EMAIL=

# Optional — defaults to server/data/iroas.db
DB_PATH=

# Public app URL used in welcome / approval emails (login + QR links)
# and as the AddPay return_url after checkout.
PUBLIC_APP_URL=http://localhost:5173

# Optional comma-separated extra browser origins allowed by CORS
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Public API origin AddPay can reach for webhooks (notify_url).
# In production with Nginx proxying /api, this can match PUBLIC_APP_URL.
# Locally AddPay cannot reach localhost — owners sync via order query on return.
# PUBLIC_API_URL=https://your-domain.com

# Gmail SMTP (used when ZeptoMail token is not set)
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ZeptoMail HTTP API (preferred — works when SMTP is blocked)
# Token from ZeptoMail → Agents → SMTP/API → Send Mail Token
# Or paste in Platform Admin → Email settings
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_EMAIL=noreply@yourdomain.com
ZEPTOMAIL_FROM_NAME=IROAS
# Optional override; default https://api.zeptomail.com/v1.1/email
# ZEPTOMAIL_API_URL=

# Development catcher: Ethereal preview URLs when Zepto/SMTP are missing
# Defaults on in non-production. Set false to force hard failures.
EMAIL_DEV_CATCHER=true

# AddPay (PayCloud CNP) — onboarding launch payment.
# All of these can also be pasted in Platform Admin → Payment settings
# instead (DB overrides these env vars, same as ZeptoMail above).
ADDPAY_APP_ID=
ADDPAY_MERCHANT_NO=
ADDPAY_STORE_NO=
# Your RSA private key — signs outgoing checkout requests. Paste with or
# without BEGIN/END lines; both are accepted.
ADDPAY_PRIVATE_KEY=
# AddPay's RSA public key — verifies incoming webhook signatures.
ADDPAY_GATEWAY_PUBLIC_KEY=
# true = sandbox (open-uat.paycloud.africa), false = production (real charges)
ADDPAY_SANDBOX=true

# Google Sign-In (Identity Services). Client ID from Google Cloud Console
# → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
# Can also be set in Platform Admin → Google sign-in (DB overrides env).
GOOGLE_CLIENT_ID=
GOOGLE_AUTH_ENABLED=true

# URY / Frappe POS (server-side only — never exposed to the frontend).
URY_BASE_URL=https://iroas.atlantechglobal.com

# Operator credential — used ONLY by operator scripts (scripts/ury-verify.js,
# scripts/ury-link-restaurant.js --list). Restaurant requests never use it.
# Use EITHER an API key/secret (Frappe: User → API Access → Generate Keys)
# OR a URY username/password. Key/secret wins when both are set.
URY_API_KEY=
URY_API_SECRET=
URY_USERNAME=
URY_PASSWORD=

# Per-restaurant integration users. Each linked IROAS restaurant has its own
# dedicated URY user (assigned only to that restaurant's Branch). The mapping
# stores only the reference name (e.g. TENANT_62); set the secret here:
#   URY_CRED_<REF>_API_KEY=      URY_CRED_<REF>_API_SECRET=     (preferred)
#   URY_CRED_<REF>_USERNAME=     URY_CRED_<REF>_PASSWORD=
# Then link: node scripts/ury-link-restaurant.js link <owner-email> --restaurant "..." \
#   --branch "..." --pos-profile "..." --credential-ref TENANT_62 [--self-ordering-profile "..."]
# URY_CRED_TENANT_62_API_KEY=
# URY_CRED_TENANT_62_API_SECRET=

# Development only (ignored when NODE_ENV=production): allow a mapping to
# verify while authenticated as URY "Administrator". Off by default. Even when
# on, one URY user can back only one IROAS restaurant.
# URY_ALLOW_ADMINISTRATOR_CREDENTIAL=false

# Per-request URY timeout (ms) and how long a guest order with an unknown
# outcome is only verified (never re-sent) before IROAS may re-send it on the
# same URY session.
# URY_REQUEST_TIMEOUT_MS=15000
# URY_GUEST_ORDER_RETRY_AFTER_MS=150000
