PORT=4000
NODE_ENV=development

# Long random string in production — e.g. `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-long-random-string

# Seeded platform admin login (used by `npm run seed`)
# ADMIN_EMAIL is also used as a fallback admin notify address
ADMIN_EMAIL=admin@iroas.com
ADMIN_PASSWORD=IroasAdmin@123
ADMIN_NAME=IROAS Admin

# Preferred inbox for onboarding review + approval notification emails
ADMIN_NOTIFY_EMAIL=

# Optional — defaults to server/data/iroas.db
DB_PATH=

# Public app URL used in welcome / approval emails (login + QR links)
PUBLIC_APP_URL=http://localhost:5173

# Gmail SMTP (used when ZeptoMail token is not set)
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ZeptoMail HTTP API (preferred — works when SMTP is blocked)
# Token from ZeptoMail → Agents → SMTP/API → Send Mail Token
# Or paste in Platform Admin → Email settings
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_EMAIL=noreply@yourdomain.com
ZEPTOMAIL_FROM_NAME=IROAS
# Optional override; default https://api.zeptomail.com/v1.1/email
# ZEPTOMAIL_API_URL=

# Development catcher: Ethereal preview URLs when Zepto/SMTP are missing
# Defaults on in non-production. Set false to force hard failures.
EMAIL_DEV_CATCHER=true
