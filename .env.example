# Frontend environment variables (Vite requires VITE_ prefix)
VITE_API_BASE_URL=/api

# Absolute public origin for QR codes and share links (no trailing slash).
# Local phone testing example: http://192.168.1.20:5173
# Production example: https://your-domain.com
# If empty, the app uses window.location.origin (fine when admin opens the live domain).
VITE_PUBLIC_BASE_URL=

# Branding / integrations
VITE_APP_DOMAIN=iroas.com
VITE_QR_SERVICE_URL=https://api.qrserver.com/v1/create-qr-code/

# Dev server API proxy target (vite.config.js)
VITE_DEV_API_PROXY=http://localhost:4000
